{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Movie Ticket Booking Made Simple (MERN Capstone)",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm.cmd install && cd server && npm.cmd install && cd ../client && npm.cmd install",
    "dev": "concurrently \"npm.cmd run dev:server\" \"npm.cmd run dev:client\"",
    "dev:server": "cd server && node server.js",
    "dev:client": "cd client && npm.cmd run dev",
    "seed": "cd server && node seeders/seed.js",
    "build:client": "cd client && npm.cmd run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "movies",
    "ticket-booking",
    "capstone",
    "react",
    "express",
    "mongodb"
  ],
  "author": "IMovies Team",
  "license": "ISC"
}

